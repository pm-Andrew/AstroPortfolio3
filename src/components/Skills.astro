---
// Skills.astro

const skillCategories = [
  {
    category: "Frontend",
    skills: [
      "HTML5",
      "CSS3",
      "JavaScript",
      "Bootstrap 5",
      "Astro",
      "Tailwind CSS",
      "React",
    ],
    tone: "bg-paper-white  hover:bg-cyan-500/20 hover:border-cyan-500 hover:text-cyan-300",
  },
  {
    category: "Backend",
    skills: [
      "PHP",
      "Python",
      "C#",
      "REST API",
      "MariaDB",
      "SQL Server",
      "WordPress",
    ],
    tone: "bg-paper-white hover:bg-orange-500/20 hover:border-orange-500 hover:text-orange-300",
  },
  {
    category: "Tools & Others",
    skills: [
      "Git",
      "GitHub",
      "VS Code",
      "XAMPP",
      "Figma",
      "AWS",
      "Azure Data Studio",
      "Linux OS",
      "Mac OS",
      "Windows OS",
    ],
    tone: "bg-paper-white hover:border-blue-500 hover:text-blue-300",
  },
];

interface Props {
  title?: string;
}

const { title = "Skills" } = Astro.props;

// Flatten into a single list of { name, tone } pairs — no category grouping in the markup
const allSkills = skillCategories.flatMap(({ skills, tone }) =>
  skills.map((name) => ({ name, tone })),
);
---

<section
  class="flex flex-col gap-2 p-3 w-3/3 rounded-2xl bg-tengu-red/20 outline-tengu-red/75 hover:outline-tengu-red outline-4"
>
  <h2 class="text-2xl font-semibold">{title}</h2>

  <ul class="flex flex-wrap gap-2">
    {
      allSkills.map(({ name, tone }) => (
        <li
          class={`flex items-center gap-2 rounded-lg border border-current px-3 py-1.5 transition-colors ${tone}`}
        >
          <span class="text-sm">{name}</span>
        </li>
      ))
    }
  </ul>
</section>
