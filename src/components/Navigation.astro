---
const navItems = [
  { label: "Home", href: "/" },
  { label: "About", href: "#about" },
  { label: "Projects", href: "#projects" },
  { label: "Contact", href: "#contact" },
  //   { label: "Resume", href: "/resume" },
  //   { label: "Blog", href: "https://portjblog.netlify.app/" },
];
---

<nav id="main-menu" aria-label="Primary" class="py-2">
  <div class="mt-2 font-semibold">
    {
      navItems.map((item) => (
        <a
          class="mr-2 text-red-500 font-bold hover:text-white transition-colors"
          href={item.href}
        >
          {item.label}
        </a>
      ))
    }
  </div>
</nav>
