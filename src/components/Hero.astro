---
import Navigation from "./Navigation.astro";
---

<!-- Start of Grid -->
<div class="mx-2 p-3 w-3/3 rounded-2xl bg-sumi-black">
  <div class="m-3 text-2xl">
    <h2
      id="top"
      class="xl:text-3xl lg:text-3xl md:text-xl sm:text-sm sm:text-wrap text-tengu-red bg-accent-foreground/90 rounded-2xl outline-tengu-red/85 outline-4 p-2 text-center"
    >
      Crafting secure adaptive accessible solutions through digital means.
    </h2>
  </div>
  <div class="grid grid-cols-8 grid-rows-10 gap-2 rounded-2xl">
    <!-- Start of cells -->
    <div
      class="flex items-end justify-start m-2 p-2 col-span-6 bg-night-indigo outline-paper-white/75 hover:outline-paper-white outline-4 rounded-2xl"
    >
      <div class="px-3 py-1 text-paper-white rounded-xl">
        Welcome to my Porfolio
      </div>
    </div>
    <div
      class="flex items-end justify-start m-2 p-2 col-span-2 row-span-7 bg-night-indigo outline-paper-white/75 hover:outline-paper-white outline-4 r rounded-2xl"
    >
      <div class="px-3 py-1 text-paper-white rounded-xl">Design</div>
    </div>
    <div
      class="flex items-end justify-start m-2 p-2 col-span-6 row-span-6 bg-night-indigo outline-paper-white/75 hover:outline-paper-white outline-4 rounded-2xl"
    >
      <div class="px-3 py-1 text-paper-white rounded-xl">Development</div>
    </div>
    <div
      class="flex items-end justify-start m-2 p-2 col-span-8 row-span-3 bg-night-indigo outline-paper-white/75 hover:outline-paper-white outline-4 rounded-2xl"
    >
      <div class="px-3 py-1 text-paper-white rounded-xl">Security</div>
    </div>
  </div>
</div>
