---
import Navigation from "./Navigation.astro";
import Skills from "./Skills.astro";
---

<div
  class="min-w-screen max-w-screen col-span-2 mx-2 p-3 w-3/3 bg-sumi-black/75 outline-paper-white/75 hover:outline-paper-white outline-4"
>
  <div class="m-3 text-2xl">
    <h2
      id="top"
      class="xl:text-3xl lg:text-3xl md:text-xl sm:text-sm sm:text-wrap text-tengu-red bg-accent-foreground/90 rounded-2xl outline-tengu-red/85 outline-4 p-2 text-center"
    >
      Crafting secure adaptive accessible solutions through digital means.
    </h2>
  </div>
  <Skills title="Skills" />
</div>
